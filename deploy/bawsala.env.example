# Copy to /etc/bawsala/bawsala.env on the VPS and chmod 600.
# Never commit the real values.
ConnectionStrings__DanaCotechDb=Server=YOUR_SQL_HOST;Database=DanaCotechDb;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True
Frontend__BaseUrl=https://www.bawsala1.com
Payments__Provider=MEPS
Payments__Meps__GatewayUrl=https://mepspay.gateway.mastercard.com
Payments__Meps__ApiVersion=100
Payments__Meps__MerchantId=YOUR_MERCHANT_ID
Payments__Meps__ApiPassword=YOUR_API_PASSWORD
Payments__Meps__MerchantName=Bawsala Consultancy
