# Copy to /etc/bawsala/bawsala.env on the VPS and chmod 600.
# Never commit the real values.
ConnectionStrings__DanaCotechDb=Server=YOUR_SQL_HOST;Database=DanaCotechDb;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True
Frontend__BaseUrl=https://www.bawsala1.com
Email__Enabled=true
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__EnableSsl=true
Email__Username=YOUR_GMAIL_ADDRESS
Email__Password=YOUR_GMAIL_APP_PASSWORD
Email__FromAddress=YOUR_VERIFIED_SENDER_ADDRESS
Email__FromName=Bawsala
Email__SupportEmail=YOUR_SUPPORT_ADDRESS
Email__TimeoutMilliseconds=30000
GoogleCalendar__Enabled=true
GoogleCalendar__CalendarId=primary
GoogleCalendar__ClientId=YOUR_GOOGLE_OAUTH_CLIENT_ID
GoogleCalendar__ClientSecret=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GoogleCalendar__RefreshToken=YOUR_GOOGLE_OAUTH_REFRESH_TOKEN
GoogleCalendar__TimeZone=Asia/Amman
GoogleCalendar__CreateMeetLink=true
Payments__Provider=MEPS
Payments__Meps__GatewayUrl=https://mepspay.gateway.mastercard.com
Payments__Meps__ApiVersion=100
Payments__Meps__MerchantId=YOUR_MERCHANT_ID
Payments__Meps__ApiPassword=YOUR_API_PASSWORD
Payments__Meps__MerchantName=Bawsala Consultancy
