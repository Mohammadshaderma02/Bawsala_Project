[Unit]
Description=Bawsala ASP.NET Core API
After=network.target

[Service]
WorkingDirectory=/var/www/project/backend
ExecStart=/usr/bin/dotnet /var/www/project/backend/DanaCotech.Api.dll
Restart=always
RestartSec=5
KillSignal=SIGINT
SyslogIdentifier=danacotech-backend
User=www-data
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5115
EnvironmentFile=/etc/bawsala/bawsala.env

[Install]
WantedBy=multi-user.target
